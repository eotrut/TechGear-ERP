# Copy to .env.local for development. Every variable here is validated at
# startup by src/lib/env.ts; the app refuses to boot if one is missing or malformed.

# Postgres. Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://techgear:techgear_dev@localhost:5432/techgear_erp?schema=public"

# Auth.js v5. Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin of this deployment.
AUTH_URL="http://localhost:3000"

# "development" | "test" | "production"
NODE_ENV="development"
